}

void DisplayManager::showError(const String& message) {
    tft.fillScreen(COLOR_RED);
    tft.setTextColor(COLOR_WHITE, COLOR_RED);
    tft.setTextSize(2);
    tft.drawString("ERROR", 10, 50);
    tft.setTextSize(1);
    tft.drawString(message, 10, 100);
}

void DisplayManager::showMessage(const String& message, uint16_t color) {
    // Temporary message overlay
    tft.fillRect(10, 100, 300, 40, COLOR_BLACK);
    tft.drawRect(10, 100, 300, 40, color);
    tft.setTextColor(color, COLOR_BLACK);
    tft.setTextSize(1);
    tft.drawString(message, 15, 115);
}