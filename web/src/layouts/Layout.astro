---
import "../styles/global.css";
import Notifications from "../components/Notifications.astro";

export interface Props {
  title?: string;
  description?: string;
}

const { title = "ADA Sensor System", description = "Professional ESP32 Analog Sensor Management System" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | ADA System</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
  </head>
  <body class="h-full">
    <slot />
    
    <!-- Global Notifications -->
    <Notifications />
    
    <!-- Simple initialization without ES modules -->
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        // Initialize basic functionality
        window.showToast = function(message, type = 'info') {
          console.log(`[${type.toUpperCase()}] ${message}`);
        };
        
        window.restartSystem = async function() {
          try {
            const response = await fetch('/api/system/restart', { method: 'POST' });
            if (response.ok) {
              window.showToast('System restart initiated', 'success');
            } else {
              throw new Error('Failed to restart system');
            }
          } catch (error) {
            window.showToast('Failed to restart system: ' + error.message, 'error');
          }
        };
        
        window.resetWifi = async function() {
          try {
            const response = await fetch('/api/wifi/reset', { method: 'POST' });
            if (response.ok) {
              window.showToast('WiFi reset initiated', 'success');
            } else {
              throw new Error('Failed to reset WiFi');
            }
          } catch (error) {
            window.showToast('Failed to reset WiFi: ' + error.message, 'error');
          }
        };
        
        window.calibrateSensor = async function(sensorId) {
          try {
            const response = await fetch(`/api/sensors/${sensorId}/calibrate`, { method: 'POST' });
            if (response.ok) {
              window.showToast('Sensor calibration started', 'success');
            } else {
              throw new Error('Failed to calibrate sensor');
            }
          } catch (error) {
            window.showToast('Failed to calibrate sensor: ' + error.message, 'error');
          }
        };
        
        window.fetchAnalytics = async function(params) {
          try {
            const queryParams = new URLSearchParams({
              sensor: params.sensor || 'all',
              timeRange: params.timeRange || '24h',
              granularity: params.granularity || '1h'
            });
            
            const response = await fetch(`/api/analytics/summary?${queryParams}`);
            if (response.ok) {
              const data = await response.json();
              // Update store with fetched data
              if (window.adaStore && window.adaStore.analytics) {
                window.adaStore.analytics.value.data = data;
              }
              return data;
            } else {
              throw new Error('Failed to fetch analytics data');
            }
          } catch (error) {
            window.showToast('Failed to fetch analytics: ' + error.message, 'error');
            throw error;
          }
        };
        
        window.formatTime = function(timestamp) {
          if (!timestamp) return '--';
          const date = new Date(typeof timestamp === 'number' ? timestamp * 1000 : timestamp);
          return date.toLocaleString();
        };
        
        // Legacy ADA object for compatibility
        window.ADA = {
          formatTime: window.formatTime
        };
        
        // Initialize basic store structure
        window.adaStore = {
          sensors: { value: { data: { sensors: [] } } },
          sensor: { value: { voltage: null, health: null } },
          system: { value: { status: null } },
          config: { value: { data: { sensors: [] } } },
          analytics: { value: { data: null } },
          ui: { value: { notifications: [] } },
          // Subscribe method for compatibility
          subscribe: function(callback) {
            // Basic subscribe - in real implementation this would be reactive
            return function unsubscribe() {};
          }
        };
        
        // Add subscribe methods to each store property
        Object.keys(window.adaStore).forEach(key => {
          if (key !== 'subscribe' && window.adaStore[key] && window.adaStore[key].value !== undefined) {
            window.adaStore[key].subscribe = function(callback) {
              // Basic subscribe - in real implementation this would be reactive
              return function unsubscribe() {};
            };
          }
        });
        
        window.adaActions = {
          restartSystem: window.restartSystem,
          resetWifi: window.resetWifi,
          calibrateSensor: window.calibrateSensor,
          fetchAnalytics: window.fetchAnalytics,
          addNotification: window.showToast
        };
        
        console.log('ADA System basic initialization complete');
        console.log('adaStore:', window.adaStore);
        console.log('adaActions:', window.adaActions);
        
        // Trigger event to notify other scripts that adaStore is ready
        console.log('Dispatching ada:store-ready event');
        window.dispatchEvent(new CustomEvent('ada:store-ready'));
        console.log('ada:store-ready event dispatched');
      });
    </script>
  </body>
</html>