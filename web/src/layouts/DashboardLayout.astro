---
import Layout from './Layout.astro';
import RTUSidebarSelector from '../components/RTUSidebarSelector.astro';

export interface Props {
  title?: string;
  description?: string;
  activePage?: string;
}

const { title, description, activePage = 'dashboard' } = Astro.props;

const navigation = [
  { name: 'Dashboard', href: '/', icon: 'fas fa-tachometer-alt', id: 'dashboard' },
  { name: 'Digital I/O', href: '/digital-io', icon: 'fas fa-toggle-on', id: 'digital-io' },
  { name: '4-20mA Sensors', href: '/analog-current', icon: 'fas fa-tachometer-alt', id: 'analog-current' },
  { name: 'Analog Voltage', href: '/analog-voltage', icon: 'fas fa-bolt', id: 'analog-voltage' },
  { name: 'Modbus Devices', href: '/modbus', icon: 'fas fa-network-wired', id: 'modbus' },
  { name: 'Analytics', href: '/analytics', icon: 'fas fa-chart-line', id: 'analytics' },
  { name: 'Diagnostics', href: '/diagnostics', icon: 'fas fa-stethoscope', id: 'diagnostics' },
  { name: 'Alarms', href: '/alarms', icon: 'fas fa-exclamation-triangle', id: 'alarms' },
  { name: 'Webhooks', href: '/webhooks', icon: 'fas fa-webhook', id: 'webhooks' },
  { name: 'Settings', href: '/settings', icon: 'fas fa-cog', id: 'settings' },
];
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gray-50">
    <!-- Mobile menu button -->
    <div class="lg:hidden">
      <div class="flex items-center justify-between px-4 py-3 bg-white border-b">
        <h1 class="text-xl font-semibold text-gray-800">ADA System</h1>
        <button id="mobile-menu-button" class="text-gray-500 hover:text-gray-700">
          <i class="fas fa-bars text-xl"></i>
        </button>
      </div>
    </div>

    <div class="flex">
      <!-- Sidebar -->
      <div id="sidebar" class="hidden lg:flex lg:flex-shrink-0">
        <div class="flex flex-col w-64">
          <div class="flex flex-col flex-grow pt-5 pb-4 overflow-y-auto bg-white border-r">
            <!-- Logo -->
            <div class="flex items-center flex-shrink-0 px-4">
              <i class="fas fa-microchip text-2xl text-indigo-600 mr-3"></i>
              <h1 class="text-xl font-bold text-gray-800">ADA System</h1>
            </div>
            
            <!-- Connection Status -->
            <div class="mt-6 px-4">
              <div id="connection-status" class="flex items-center p-3 bg-gray-50 rounded-lg">
                <div id="status-indicator" class="w-3 h-3 bg-gray-400 rounded-full mr-3"></div>
                <div>
                  <div class="text-sm font-medium text-gray-700">ESP32 Status</div>
                  <div id="status-text" class="text-xs text-gray-500">Connecting...</div>
                </div>
              </div>
            </div>

            <!-- RTU Selector -->
            <RTUSidebarSelector />

            <!-- Navigation -->
            <nav class="mt-4 flex-1 px-4 space-y-1">
              {navigation.map((item) => (
                <a
                  href={item.href}
                  class={`group flex items-center px-3 py-2 text-sm font-medium rounded-md transition-colors duration-200 ${
                    activePage === item.id
                      ? 'bg-indigo-100 text-indigo-700'
                      : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900'
                  }`}
                >
                  <i class={`${item.icon} mr-3 flex-shrink-0 text-lg ${
                    activePage === item.id ? 'text-indigo-500' : 'text-gray-400 group-hover:text-gray-500'
                  }`}></i>
                  {item.name}
                </a>
              ))}
            </nav>

            <!-- System Info (compact) -->
            <div class="px-4 pb-4">
              <div class="bg-gray-50 rounded-lg p-3">
                <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">System Info</div>
                <div class="space-y-1">
                  <div class="flex justify-between text-xs">
                    <span class="text-gray-600">Uptime:</span>
                    <span id="system-uptime" class="text-gray-900">--</span>
                  </div>
                  <div class="flex justify-between text-xs">
                    <span class="text-gray-600">Memory:</span>
                    <span id="system-memory" class="text-gray-900">--</span>
                  </div>
                  <div class="flex justify-between text-xs">
                    <span class="text-gray-600">WiFi:</span>
                    <span id="wifi-signal" class="text-gray-900">--</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile sidebar overlay -->
      <div id="sidebar-overlay" class="hidden fixed inset-0 z-40 lg:hidden">
        <div class="fixed inset-0 bg-gray-600 bg-opacity-75"></div>
        <div class="relative flex-1 flex flex-col max-w-xs w-full bg-white">
          <div class="absolute top-0 right-0 -mr-12 pt-2">
            <button id="close-sidebar" class="ml-1 flex items-center justify-center h-10 w-10 rounded-full focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white">
              <i class="fas fa-times text-white"></i>
            </button>
          </div>
          <!-- Mobile navigation content goes here -->
        </div>
      </div>

      <!-- Main content -->
      <div class="flex-1 min-w-0">
        <!-- Page header -->
        <div class="bg-white shadow-sm border-b">
          <div class="px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate" id="page-title">
                  {title || 'Dashboard'}
                </h2>
                <p class="mt-1 text-sm text-gray-500" id="page-description">
                  {description || 'Real-time sensor monitoring and system management'}
                </p>
              </div>
              
              <!-- Real-time indicator -->
              <div class="flex items-center space-x-4">
                <div class="flex items-center text-sm text-gray-500">
                  <div id="realtime-indicator" class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></div>
                  Live Data
                </div>
                <div class="text-sm text-gray-500">
                  Last Update: <span id="last-update">--</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Page content -->
        <main class="flex-1">
          <div class="py-6">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
              <slot />
            </div>
          </div>
        </main>
      </div>
    </div>
  </div>

  <!-- Toast notifications -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>
</Layout>

<script>
  // Mobile menu toggle
  document.getElementById('mobile-menu-button')?.addEventListener('click', () => {
    document.getElementById('sidebar-overlay')?.classList.remove('hidden');
  });
  
  document.getElementById('close-sidebar')?.addEventListener('click', () => {
    document.getElementById('sidebar-overlay')?.classList.add('hidden');
  });

  // Connection status monitoring
  async function updateConnectionStatus() {
    try {
      console.log('Updating connection status...');
      const response = await fetch('/ada-1/api/status');
      
      if (response.ok) {
        const data = await response.json();
        console.log('✅ ESP32 connected - status data:', data);
        
        const statusIndicator = document.getElementById('status-indicator');
        const statusText = document.getElementById('status-text');
        
        // Update connection status
        statusIndicator?.classList.remove('bg-gray-400', 'bg-red-400', 'bg-yellow-400');
        statusIndicator?.classList.add('bg-green-400');
        if (statusText) statusText.textContent = 'Connected to ada-1';
        
        // Update system info in sidebar
        const systemUptime = document.getElementById('system-uptime');
        const systemMemory = document.getElementById('system-memory');
        const wifiSignal = document.getElementById('wifi-signal');
        
        if (systemUptime && data.uptime) {
          systemUptime.textContent = data.uptime;
        }
        
        if (systemMemory && data.freeHeap) {
          systemMemory.textContent = Math.round(data.freeHeap / 1024) + ' KB';
        }
        
        if (wifiSignal && data.wifi?.rssi) {
          wifiSignal.textContent = data.wifi.rssi + ' dBm';
        }
        
        console.log('✅ Connection status updated successfully');
      } else {
        throw new Error(`HTTP ${response.status}`);
      }
    } catch (error) {
      console.warn('⚠️ ESP32 API not available, using fallback mode:', error.message);
      
      const statusIndicator = document.getElementById('status-indicator');
      const statusText = document.getElementById('status-text');
      
      // Show fallback mode instead of error
      statusIndicator?.classList.remove('bg-gray-400', 'bg-green-400', 'bg-red-400');
      statusIndicator?.classList.add('bg-yellow-400');
      if (statusText) statusText.textContent = 'Fallback Mode';
      
      // Show fallback system info
      const systemUptime = document.getElementById('system-uptime');
      const systemMemory = document.getElementById('system-memory');
      const wifiSignal = document.getElementById('wifi-signal');
      
      if (systemUptime) systemUptime.textContent = 'Demo Mode';
      if (systemMemory) systemMemory.textContent = '256 KB';
      if (wifiSignal) wifiSignal.textContent = '-45 dBm';
    }
  }

  // Toast notification function
  window.showToast = function(message, type = 'info') {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    
    const colors = {
      success: 'bg-green-500',
      error: 'bg-red-500',
      warning: 'bg-yellow-500',
      info: 'bg-blue-500'
    };
    
    toast.className = `${colors[type]} text-white px-4 py-3 rounded-lg shadow-lg transform transition-all duration-300 translate-x-full`;
    toast.innerHTML = `
      <div class="flex items-center justify-between">
        <span>${message}</span>
        <button onclick="this.parentElement.parentElement.remove()" class="ml-3 text-white hover:text-gray-200">
          <i class="fas fa-times"></i>
        </button>
      </div>
    `;
    
    container?.appendChild(toast);
    
    // Animate in
    setTimeout(() => toast.classList.remove('translate-x-full'), 100);
    
    // Auto remove after 5 seconds
    setTimeout(() => {
      toast.classList.add('translate-x-full');
      setTimeout(() => toast.remove(), 300);
    }, 5000);
  };

  // Update last update timestamp
  function updateLastUpdate() {
    document.getElementById('last-update').textContent = new Date().toLocaleTimeString();
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    updateConnectionStatus();
    updateLastUpdate();
    
    // Update connection status every 30 seconds
    setInterval(updateConnectionStatus, 30000);
    
    // Update timestamp on sensor data
    document.addEventListener('ada:sensor-data', updateLastUpdate);
  });
</script>