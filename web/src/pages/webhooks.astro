---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout 
  title="Webhooks" 
  description="Webhook management, configuration, and monitoring"
  activePage="webhooks"
>
  <!-- Webhook Controls -->
  <div class="mb-8 bg-white shadow rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Webhook Management</h3>
        <div class="flex items-center space-x-4">
          <button onclick="createWebhook()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium">
            <i class="fas fa-plus mr-2"></i>Add Webhook
          </button>
          <button onclick="testAllWebhooks()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium">
            <i class="fas fa-flask mr-2"></i>Test All
          </button>
          <button onclick="refreshWebhooks()" class="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-md text-sm font-medium">
            <i class="fas fa-sync-alt mr-2"></i>Refresh
          </button>
        </div>
      </div>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label for="webhook-filter" class="block text-sm font-medium text-gray-700">Filter by Status</label>
          <select id="webhook-filter" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
            <option value="all">All Webhooks</option>
            <option value="enabled">Enabled</option>
            <option value="disabled">Disabled</option>
            <option value="error">Error</option>
          </select>
        </div>
        <div>
          <label for="event-filter" class="block text-sm font-medium text-gray-700">Filter by Event Type</label>
          <select id="event-filter" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
            <option value="all">All Events</option>
            <option value="alarm">Alarm Events</option>
            <option value="sensor_data">Sensor Data</option>
            <option value="system_event">System Events</option>
            <option value="diagnostic">Diagnostic Events</option>
          </select>
        </div>
        <div class="flex items-end">
          <button onclick="clearWebhookQueue()" class="w-full bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium">
            <i class="fas fa-trash mr-2"></i>Clear Queue
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Webhook Statistics -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <i class="fas fa-globe text-2xl text-blue-600"></i>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Total Webhooks</dt>
              <dd class="text-lg font-medium text-gray-900" id="stat-total">0</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <i class="fas fa-check-circle text-2xl text-green-600"></i>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Active</dt>
              <dd class="text-lg font-medium text-gray-900" id="stat-active">0</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <i class="fas fa-hourglass-half text-2xl text-yellow-600"></i>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Pending Queue</dt>
              <dd class="text-lg font-medium text-gray-900" id="stat-pending">0</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <i class="fas fa-exclamation-triangle text-2xl text-red-600"></i>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Failed Today</dt>
              <dd class="text-lg font-medium text-gray-900" id="stat-failed">0</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column - Webhook List -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Webhooks List -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Configured Webhooks</h3>
        </div>
        <div class="divide-y divide-gray-200">
          <div id="webhooks-list">
            <!-- Webhooks will be populated by JavaScript -->
          </div>
        </div>
      </div>

      <!-- Delivery Queue -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <div class="flex items-center justify-between">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Delivery Queue</h3>
            <button onclick="refreshQueue()" class="text-sm text-indigo-600 hover:text-indigo-800">
              <i class="fas fa-sync-alt mr-1"></i>Refresh
            </button>
          </div>
        </div>
        <div class="divide-y divide-gray-200 max-h-96 overflow-y-auto">
          <div id="webhook-queue-list">
            <!-- Queue items will be populated by JavaScript -->
          </div>
        </div>
      </div>

      <!-- Delivery History -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Recent Deliveries</h3>
        </div>
        <div class="divide-y divide-gray-200 max-h-96 overflow-y-auto">
          <div id="webhook-history-list">
            <!-- History will be populated by JavaScript -->
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column - Controls and Settings -->
    <div class="space-y-8">
      <!-- Global Settings -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Global Settings</h3>
        </div>
        <div class="p-6">
          <div class="space-y-4">
            <div>
              <label for="retry-attempts" class="block text-sm font-medium text-gray-700">Max Retry Attempts</label>
              <input type="number" id="retry-attempts" min="0" max="10" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <div>
              <label for="retry-delay" class="block text-sm font-medium text-gray-700">Retry Delay (seconds)</label>
              <input type="number" id="retry-delay" min="1" max="3600" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <div>
              <label for="timeout" class="block text-sm font-medium text-gray-700">Request Timeout (seconds)</label>
              <input type="number" id="timeout" min="1" max="60" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <div class="flex items-center justify-between">
              <label class="text-sm font-medium text-gray-700">Enable Queue Processing</label>
              <input type="checkbox" id="enable-queue" class="rounded">
            </div>
          </div>
          <button onclick="saveGlobalSettings()" class="mt-4 w-full bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium">
            Save Settings
          </button>
        </div>
      </div>

      <!-- Queue Management -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Queue Management</h3>
        </div>
        <div class="p-6">
          <div class="space-y-3">
            <button onclick="processQueue()" class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
              <i class="fas fa-play mr-2"></i>
              Process Queue Now
            </button>
            <button onclick="pauseQueue()" class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
              <i class="fas fa-pause mr-2"></i>
              Pause Queue Processing
            </button>
            <button onclick="clearFailedItems()" class="w-full flex items-center justify-center px-4 py-2 border border-red-300 text-sm font-medium rounded-md text-red-700 bg-red-50 hover:bg-red-100">
              <i class="fas fa-trash mr-2"></i>
              Clear Failed Items
            </button>
          </div>
        </div>
      </div>

      <!-- Webhook Templates -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Quick Templates</h3>
        </div>
        <div class="p-6">
          <div class="space-y-3">
            <button onclick="createFromTemplate('slack')" class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
              <i class="fab fa-slack mr-2"></i>
              Slack Notification
            </button>
            <button onclick="createFromTemplate('discord')" class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
              <i class="fab fa-discord mr-2"></i>
              Discord Notification
            </button>
            <button onclick="createFromTemplate('teams')" class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
              <i class="fab fa-microsoft mr-2"></i>
              Microsoft Teams
            </button>
            <button onclick="createFromTemplate('generic')" class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
              <i class="fas fa-globe mr-2"></i>
              Generic HTTP
            </button>
          </div>
        </div>
      </div>

      <!-- Webhook Testing -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Test Webhook</h3>
        </div>
        <div class="p-6">
          <div class="space-y-4">
            <div>
              <label for="test-url" class="block text-sm font-medium text-gray-700">Test URL</label>
              <input type="url" id="test-url" placeholder="https://example.com/webhook" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <div>
              <label for="test-payload" class="block text-sm font-medium text-gray-700">Test Payload (JSON)</label>
              <textarea id="test-payload" rows="4" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" placeholder='{"test": true}'></textarea>
            </div>
            <button onclick="testWebhookUrl()" class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium">
              <i class="fas fa-paper-plane mr-2"></i>Send Test
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Webhook Creation/Edit Modal -->
  <div id="webhook-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full mx-4 max-h-screen overflow-y-auto">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">Create Webhook</h3>
      </div>
      <div class="p-6">
        <form id="webhook-form" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="webhook-name" class="block text-sm font-medium text-gray-700">Name</label>
              <input type="text" id="webhook-name" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <div>
              <label for="webhook-enabled" class="flex items-center">
                <input type="checkbox" id="webhook-enabled" class="rounded mr-2">
                <span class="text-sm font-medium text-gray-700">Enabled</span>
              </label>
            </div>
          </div>
          
          <div>
            <label for="webhook-url" class="block text-sm font-medium text-gray-700">URL</label>
            <input type="url" id="webhook-url" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="webhook-method" class="block text-sm font-medium text-gray-700">HTTP Method</label>
              <select id="webhook-method" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
                <option value="POST">POST</option>
                <option value="PUT">PUT</option>
                <option value="PATCH">PATCH</option>
              </select>
            </div>
            <div>
              <label for="webhook-timeout" class="block text-sm font-medium text-gray-700">Timeout (seconds)</label>
              <input type="number" id="webhook-timeout" min="1" max="60" value="30" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500">
            </div>
          </div>

          <div>
            <label for="webhook-events" class="block text-sm font-medium text-gray-700">Event Types</label>
            <div class="mt-2 space-y-2">
              <label class="flex items-center">
                <input type="checkbox" value="alarm" class="webhook-event-checkbox rounded mr-2">
                <span class="text-sm">Alarm Events</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" value="sensor_data" class="webhook-event-checkbox rounded mr-2">
                <span class="text-sm">Sensor Data</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" value="system_event" class="webhook-event-checkbox rounded mr-2">
                <span class="text-sm">System Events</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" value="diagnostic" class="webhook-event-checkbox rounded mr-2">
                <span class="text-sm">Diagnostic Events</span>
              </label>
            </div>
          </div>

          <div>
            <label for="webhook-headers" class="block text-sm font-medium text-gray-700">Custom Headers (JSON)</label>
            <textarea id="webhook-headers" rows="3" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" placeholder='{"Authorization": "Bearer token"}'></textarea>
          </div>

          <div>
            <label for="webhook-template" class="block text-sm font-medium text-gray-700">Payload Template (JSON)</label>
            <textarea id="webhook-template" rows="6" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" placeholder='{"event": "{{event_type}}", "data": "{{data}}"}'></textarea>
            <p class="mt-1 text-xs text-gray-500">Use <span is:raw> {{variable_name}} </span>for templating. Available variables: event_type, timestamp, sensor_id, sensor_name, value, alarm_id, etc.</p>
          </div>

          <div>
            <label for="webhook-description" class="block text-sm font-medium text-gray-700">Description</label>
            <textarea id="webhook-description" rows="2" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500"></textarea>
          </div>
        </form>
      </div>
      <div class="px-6 py-4 border-t border-gray-200 flex justify-end space-x-4">
        <button onclick="closeWebhookModal()" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
          Cancel
        </button>
        <button onclick="testWebhookConfig()" class="px-4 py-2 border border-blue-300 rounded-md text-sm font-medium text-blue-700 bg-blue-50 hover:bg-blue-100">
          Test
        </button>
        <button onclick="saveWebhook()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-md text-sm font-medium">
          Save Webhook
        </button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  let webhooks: any[] = [];
  let webhookQueue: any[] = [];
  let webhookHistory: any[] = [];
  let editingWebhookId: string | null = null;

  // Load webhook data
  async function loadWebhookData() {
    try {
      console.log('Loading webhook data...');
      
      // Load webhooks
      const webhooksResponse = await fetch('/api/webhooks');
      if (webhooksResponse.ok) {
        webhooks = await webhooksResponse.json();
        console.log('Loaded webhooks:', webhooks);
        updateWebhooksList();
        updateWebhookStats();
      } else {
        console.error('Failed to load webhooks, status:', webhooksResponse.status);
      }

      // Load queue
      const queueResponse = await fetch('/api/webhooks/queue');
      if (queueResponse.ok) {
        webhookQueue = await queueResponse.json();
        console.log('Loaded webhook queue:', webhookQueue);
        updateWebhookQueue();
      } else {
        console.error('Failed to load webhook queue, status:', queueResponse.status);
      }

      // Load history
      const historyResponse = await fetch('/api/webhooks/history?limit=20');
      if (historyResponse.ok) {
        webhookHistory = await historyResponse.json();
        console.log('Loaded webhook history:', webhookHistory);
        updateWebhookHistory();
      } else {
        console.error('Failed to load webhook history, status:', historyResponse.status);
      }

      // Load global settings
      await loadGlobalSettings();

    } catch (error) {
      console.error('Failed to load webhook data:', error);
      (window as any).showToast?.('Failed to load webhook data', 'error');
    }
  }

  // Update webhooks list
  function updateWebhooksList() {
    const container = document.getElementById('webhooks-list');
    if (!container) return;

    const statusFilter = (document.getElementById('webhook-filter') as HTMLSelectElement)?.value || 'all';
    const eventFilter = (document.getElementById('event-filter') as HTMLSelectElement)?.value || 'all';

    let filteredWebhooks = webhooks;

    if (statusFilter !== 'all') {
      filteredWebhooks = filteredWebhooks.filter(webhook => 
        statusFilter === 'enabled' ? webhook.enabled : 
        statusFilter === 'disabled' ? !webhook.enabled :
        webhook.status === statusFilter
      );
    }

    if (eventFilter !== 'all') {
      filteredWebhooks = filteredWebhooks.filter(webhook => 
        webhook.events && webhook.events.includes(eventFilter)
      );
    }

    if (filteredWebhooks.length === 0) {
      container.innerHTML = `
        <div class="p-8 text-center text-gray-500">
          <i class="fas fa-globe text-4xl mb-4"></i>
          <p>No webhooks match the current filters</p>
        </div>
      `;
      return;
    }

    container.innerHTML = filteredWebhooks.map(webhook => `
      <div class="p-6">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <div class="flex-shrink-0">
              <div class="w-3 h-3 rounded-full ${webhook.enabled ? 'bg-green-400' : 'bg-gray-400'}"></div>
            </div>
            <div class="flex-1">
              <div class="flex items-center space-x-2">
                <h4 class="text-lg font-medium text-gray-900">${webhook.name}</h4>
                <span class="px-2 py-1 text-xs font-medium rounded-full ${
                  webhook.enabled ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'
                }">
                  ${webhook.enabled ? 'Enabled' : 'Disabled'}
                </span>
              </div>
              <p class="text-sm text-gray-600 mt-1">${webhook.description || 'No description'}</p>
              <div class="flex items-center space-x-4 mt-2 text-sm text-gray-500">
                <span><i class="fas fa-link mr-1"></i>${webhook.url}</span>
                <span><i class="fas fa-calendar mr-1"></i>${webhook.events?.join(', ') || 'No events'}</span>
                <span><i class="fas fa-clock mr-1"></i>${webhook.method || 'POST'}</span>
              </div>
              <div class="flex items-center space-x-4 mt-1 text-xs text-gray-400">
                <span>Success: ${webhook.stats?.success || 0}</span>
                <span>Failed: ${webhook.stats?.failed || 0}</span>
                <span>Last delivery: ${webhook.stats?.lastDelivery ? (window as any).ADA?.formatTime(webhook.stats.lastDelivery) : 'Never'}</span>
              </div>
            </div>
          </div>
          <div class="flex items-center space-x-2">
            <button onclick="testWebhook('${webhook.id}')" class="px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white text-sm rounded-md">
              <i class="fas fa-flask mr-1"></i>Test
            </button>
            <button onclick="editWebhook('${webhook.id}')" class="px-3 py-1 bg-gray-600 hover:bg-gray-700 text-white text-sm rounded-md">
              <i class="fas fa-edit mr-1"></i>Edit
            </button>
            <button onclick="toggleWebhook('${webhook.id}')" class="px-3 py-1 ${webhook.enabled ? 'bg-yellow-600 hover:bg-yellow-700' : 'bg-green-600 hover:bg-green-700'} text-white text-sm rounded-md">
              <i class="fas ${webhook.enabled ? 'fa-pause' : 'fa-play'} mr-1"></i>${webhook.enabled ? 'Disable' : 'Enable'}
            </button>
            <button onclick="deleteWebhook('${webhook.id}')" class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white text-sm rounded-md">
              <i class="fas fa-trash mr-1"></i>Delete
            </button>
          </div>
        </div>
      </div>
    `).join('');
  }

  // Update webhook statistics
  function updateWebhookStats() {
    const stats = {
      total: webhooks.length,
      active: webhooks.filter(w => w.enabled).length,
      pending: webhookQueue.length,
      failed: webhookHistory.filter(h => {
        const today = new Date();
        const deliveryDate = new Date(h.timestamp * 1000);
        return deliveryDate.toDateString() === today.toDateString() && !h.success;
      }).length
    };

    Object.entries(stats).forEach(([key, value]) => {
      const element = document.getElementById(`stat-${key}`);
      if (element) element.textContent = value.toString();
    });
  }

  // Update webhook queue
  function updateWebhookQueue() {
    const container = document.getElementById('webhook-queue-list');
    if (!container) return;

    if (webhookQueue.length === 0) {
      container.innerHTML = '<div class="p-8 text-center text-gray-500">Queue is empty</div>';
      return;
    }

    container.innerHTML = webhookQueue.slice(0, 20).map(item => `
      <div class="p-4">
        <div class="flex items-center justify-between">
          <div>
            <div class="font-medium">${item.webhookName}</div>
            <div class="text-sm text-gray-500">${item.eventType}</div>
            <div class="text-xs text-gray-400">
              Attempts: ${item.attempts}/${item.maxAttempts} | 
              Next retry: ${item.nextRetry ? (window as any).ADA?.formatTime(item.nextRetry) : 'Now'}
            </div>
          </div>
          <div class="text-right">
            <div class="text-sm font-medium">${(window as any).ADA?.formatTime(item.timestamp)}</div>
            <button onclick="retryQueueItem('${item.id}')" class="text-xs text-indigo-600 hover:text-indigo-800">
              <i class="fas fa-redo mr-1"></i>Retry Now
            </button>
          </div>
        </div>
      </div>
    `).join('');
  }

  // Update webhook history
  function updateWebhookHistory() {
    const container = document.getElementById('webhook-history-list');
    if (!container) return;

    if (webhookHistory.length === 0) {
      container.innerHTML = '<div class="p-8 text-center text-gray-500">No delivery history</div>';
      return;
    }

    container.innerHTML = webhookHistory.slice(0, 20).map(item => `
      <div class="p-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <i class="fas ${item.success ? 'fa-check-circle text-green-500' : 'fa-times-circle text-red-500'}"></i>
            <div>
              <div class="font-medium">${item.webhookName}</div>
              <div class="text-sm text-gray-500">${item.eventType}</div>
              ${item.error ? `<div class="text-xs text-red-600">${item.error}</div>` : ''}
            </div>
          </div>
          <div class="text-right">
            <div class="text-sm font-medium">${(window as any).ADA?.formatTime(item.timestamp)}</div>
            <div class="text-xs text-gray-500">
              ${item.responseCode ? `HTTP ${item.responseCode}` : ''} | 
              ${item.duration}ms
            </div>
          </div>
        </div>
      </div>
    `).join('');
  }

  // Load global settings
  async function loadGlobalSettings() {
    try {
      const settings = await (window as any).ADA?.get('/api/webhooks/settings');
      
      if (settings) {
        const inputs = {
          'retry-attempts': settings.maxRetryAttempts,
          'retry-delay': settings.retryDelay,
          'timeout': settings.defaultTimeout,
        };

        Object.entries(inputs).forEach(([id, value]) => {
          const input = document.getElementById(id) as HTMLInputElement;
          if (input && value !== undefined) input.value = value.toString();
        });

        const enableQueueCheckbox = document.getElementById('enable-queue') as HTMLInputElement;
        if (enableQueueCheckbox) enableQueueCheckbox.checked = settings.enableQueue || false;
      }
    } catch (error) {
      console.error('Failed to load global settings:', error);
    }
  }

  // Webhook actions
  async function createWebhook() {
    editingWebhookId = null;
    document.getElementById('modal-title')!.textContent = 'Create Webhook';
    
    // Reset form
    const form = document.getElementById('webhook-form') as HTMLFormElement;
    if (form) form.reset();
    
    // Set defaults
    (document.getElementById('webhook-enabled') as HTMLInputElement).checked = true;
    (document.getElementById('webhook-method') as HTMLSelectElement).value = 'POST';
    (document.getElementById('webhook-timeout') as HTMLInputElement).value = '30';
    
    document.getElementById('webhook-modal')?.classList.remove('hidden');
    document.getElementById('webhook-modal')?.classList.add('flex');
  }

  async function editWebhook(webhookId: string) {
    editingWebhookId = webhookId;
    const webhook = webhooks.find(w => w.id === webhookId);
    
    if (!webhook) return;
    
    document.getElementById('modal-title')!.textContent = 'Edit Webhook';
    
    // Populate form
    (document.getElementById('webhook-name') as HTMLInputElement).value = webhook.name || '';
    (document.getElementById('webhook-url') as HTMLInputElement).value = webhook.url || '';
    (document.getElementById('webhook-method') as HTMLSelectElement).value = webhook.method || 'POST';
    (document.getElementById('webhook-timeout') as HTMLInputElement).value = webhook.timeout?.toString() || '30';
    (document.getElementById('webhook-enabled') as HTMLInputElement).checked = webhook.enabled || false;
    (document.getElementById('webhook-headers') as HTMLTextAreaElement).value = webhook.headers ? JSON.stringify(webhook.headers, null, 2) : '';
    (document.getElementById('webhook-template') as HTMLTextAreaElement).value = webhook.template || '';
    (document.getElementById('webhook-description') as HTMLTextAreaElement).value = webhook.description || '';
    
    // Set event checkboxes
    const eventCheckboxes = document.querySelectorAll('.webhook-event-checkbox') as NodeListOf<HTMLInputElement>;
    eventCheckboxes.forEach(checkbox => {
      checkbox.checked = webhook.events?.includes(checkbox.value) || false;
    });
    
    document.getElementById('webhook-modal')?.classList.remove('hidden');
    document.getElementById('webhook-modal')?.classList.add('flex');
  }

  function closeWebhookModal() {
    document.getElementById('webhook-modal')?.classList.add('hidden');
    document.getElementById('webhook-modal')?.classList.remove('flex');
    editingWebhookId = null;
  }

  async function saveWebhook() {
    const name = (document.getElementById('webhook-name') as HTMLInputElement)?.value;
    const url = (document.getElementById('webhook-url') as HTMLInputElement)?.value;
    const method = (document.getElementById('webhook-method') as HTMLSelectElement)?.value;
    const timeout = parseInt((document.getElementById('webhook-timeout') as HTMLInputElement)?.value);
    const enabled = (document.getElementById('webhook-enabled') as HTMLInputElement)?.checked;
    const headersText = (document.getElementById('webhook-headers') as HTMLTextAreaElement)?.value;
    const template = (document.getElementById('webhook-template') as HTMLTextAreaElement)?.value;
    const description = (document.getElementById('webhook-description') as HTMLTextAreaElement)?.value;

    // Get selected events
    const eventCheckboxes = document.querySelectorAll('.webhook-event-checkbox:checked') as NodeListOf<HTMLInputElement>;
    const events = Array.from(eventCheckboxes).map(cb => cb.value);

    if (!name || !url || events.length === 0) {
      (window as any).showToast?.('Please fill in name, URL, and select at least one event type', 'error');
      return;
    }

    let headers = {};
    if (headersText.trim()) {
      try {
        headers = JSON.parse(headersText);
      } catch (error) {
        (window as any).showToast?.('Invalid JSON in headers field', 'error');
        return;
      }
    }

    const webhookData = {
      name,
      url,
      method,
      timeout,
      enabled,
      events,
      headers,
      template,
      description
    };

    try {
      if (editingWebhookId) {
        await (window as any).ADA?.put(`/api/webhooks/${editingWebhookId}`, webhookData);
        (window as any).showToast?.('Webhook updated successfully', 'success');
      } else {
        await (window as any).ADA?.post('/api/webhooks', webhookData);
        (window as any).showToast?.('Webhook created successfully', 'success');
      }

      closeWebhookModal();
      await loadWebhookData();
    } catch (error) {
      console.error('Failed to save webhook:', error);
      (window as any).showToast?.('Failed to save webhook', 'error');
    }
  }

  async function testWebhook(webhookId: string) {
    try {
      const result = await (window as any).ADA?.post(`/api/webhooks/${webhookId}/test`);
      
      if (result && result.success) {
        (window as any).showToast?.('Webhook test successful', 'success');
      } else {
        (window as any).showToast?.(`Webhook test failed: ${result?.error || 'Unknown error'}`, 'error');
      }
    } catch (error) {
      console.error('Failed to test webhook:', error);
      (window as any).showToast?.('Failed to test webhook', 'error');
    }
  }

  async function toggleWebhook(webhookId: string) {
    try {
      const webhook = webhooks.find(w => w.id === webhookId);
      if (!webhook) return;

      await (window as any).ADA?.patch(`/api/webhooks/${webhookId}`, {
        enabled: !webhook.enabled
      });

      await loadWebhookData();
      (window as any).showToast?.(`Webhook ${webhook.enabled ? 'disabled' : 'enabled'}`, 'success');
    } catch (error) {
      console.error('Failed to toggle webhook:', error);
      (window as any).showToast?.('Failed to toggle webhook', 'error');
    }
  }

  async function deleteWebhook(webhookId: string) {
    if (!confirm('Are you sure you want to delete this webhook?')) return;

    try {
      await (window as any).ADA?.delete(`/api/webhooks/${webhookId}`);
      await loadWebhookData();
      (window as any).showToast?.('Webhook deleted successfully', 'success');
    } catch (error) {
      console.error('Failed to delete webhook:', error);
      (window as any).showToast?.('Failed to delete webhook', 'error');
    }
  }

  // Global settings and management
  async function saveGlobalSettings() {
    const settings = {
      maxRetryAttempts: parseInt((document.getElementById('retry-attempts') as HTMLInputElement)?.value),
      retryDelay: parseInt((document.getElementById('retry-delay') as HTMLInputElement)?.value),
      defaultTimeout: parseInt((document.getElementById('timeout') as HTMLInputElement)?.value),
      enableQueue: (document.getElementById('enable-queue') as HTMLInputElement)?.checked
    };

    try {
      await (window as any).ADA?.post('/api/webhooks/settings', settings);
      (window as any).showToast?.('Global settings saved', 'success');
    } catch (error) {
      console.error('Failed to save global settings:', error);
      (window as any).showToast?.('Failed to save global settings', 'error');
    }
  }

  async function refreshWebhooks() {
    await loadWebhookData();
  }

  async function refreshQueue() {
    try {
      const queueResponse = await (window as any).ADA?.get('/api/webhooks/queue');
      if (queueResponse) {
        webhookQueue = queueResponse;
        updateWebhookQueue();
      }
    } catch (error) {
      console.error('Failed to refresh queue:', error);
    }
  }

  // Event listeners
  ['webhook-filter', 'event-filter'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', updateWebhooksList);
  });

  // Initialize page
  document.addEventListener('DOMContentLoaded', () => {
    loadWebhookData();
    
    // Auto-refresh webhooks and queue every 30 seconds
    setInterval(() => {
      loadWebhookData();
    }, 30000);
  });
</script>