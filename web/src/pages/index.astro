---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout 
  title="Dashboard" 
  description="Real-time sensor monitoring and system overview"
  activePage="dashboard"
>
  <!-- Quick Stats -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Total Sensors -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <i class="fas fa-microchip text-2xl text-indigo-600"></i>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Active Sensors</dt>
              <dd class="text-lg font-medium text-gray-900" id="total-sensors">--</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <!-- System Health -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <i class="fas fa-heart text-2xl text-green-600"></i>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">System Health</dt>
              <dd class="text-lg font-medium text-gray-900" id="system-health">--</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Alarms -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <i class="fas fa-exclamation-triangle text-2xl text-yellow-600"></i>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Active Alarms</dt>
              <dd class="text-lg font-medium text-gray-900" id="active-alarms">--</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <!-- Data Points Today -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <i class="fas fa-database text-2xl text-blue-600"></i>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Data Points Today</dt>
              <dd class="text-lg font-medium text-gray-900" id="data-points">--</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column - Sensor Data -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Real-time Sensor Chart -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <div class="flex items-center justify-between">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Real-time Sensor Data</h3>
            <div class="flex items-center space-x-2">
              <button id="pause-chart" class="text-sm bg-gray-100 hover:bg-gray-200 px-3 py-1 rounded-md">
                <i class="fas fa-pause mr-1"></i> Pause
              </button>
              <select id="chart-timespan" class="text-sm border border-gray-300 rounded-md px-2 py-1">
                <option value="60">Last 1 min</option>
                <option value="300">Last 5 min</option>
                <option value="900" selected>Last 15 min</option>
                <option value="3600">Last 1 hour</option>
              </select>
            </div>
          </div>
        </div>
        <div class="p-6">
          <canvas id="sensor-chart" width="800" height="400"></canvas>
        </div>
      </div>

      <!-- Sensor List -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Sensor Status</h3>
        </div>
        <div class="p-6">
          <div id="sensor-list" class="space-y-4">
            <!-- Sensor items will be populated by JavaScript -->
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column - System Info & Alerts -->
    <div class="space-y-8">
      <!-- System Status -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg leading-6 font-medium text-gray-900">System Status</h3>
        </div>
        <div class="p-6">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600">CPU Usage</span>
              <div class="flex items-center">
                <div class="w-32 bg-gray-200 rounded-full h-2 mr-2">
                  <div id="cpu-usage-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <span id="cpu-usage" class="text-sm font-medium">0%</span>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600">Memory Usage</span>
              <div class="flex items-center">
                <div class="w-32 bg-gray-200 rounded-full h-2 mr-2">
                  <div id="memory-usage-bar" class="bg-green-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <span id="memory-usage" class="text-sm font-medium">0%</span>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600">Storage Usage</span>
              <div class="flex items-center">
                <div class="w-32 bg-gray-200 rounded-full h-2 mr-2">
                  <div id="storage-usage-bar" class="bg-yellow-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
                <span id="storage-usage" class="text-sm font-medium">0%</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Alarms -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <div class="flex items-center justify-between">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Recent Alarms</h3>
            <a href="/alarms" class="text-sm text-indigo-600 hover:text-indigo-500">View all</a>
          </div>
        </div>
        <div class="p-6">
          <div id="recent-alarms" class="space-y-3">
            <!-- Alarm items will be populated by JavaScript -->
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Quick Actions</h3>
        </div>
        <div class="p-6">
          <div class="space-y-3">
            <button onclick="toggleSimulationMode()" class="w-full flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
              <i class="fas fa-play-circle mr-2"></i>
              Toggle Simulation
            </button>
            <button onclick="exportData()" class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
              <i class="fas fa-download mr-2"></i>
              Export Data
            </button>
            <button onclick="resetAlarms()" class="w-full flex items-center justify-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
              <i class="fas fa-bell-slash mr-2"></i>
              Clear Alarms
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script is:inline>
  // Global variables
  let sensorChart = null;
  let chartData = {
    labels: [],
    datasets: []
  };
  let isPaused = false;

  // Initialize the sensor chart
  function initChart() {
    const ctx = document.getElementById('sensor-chart').getContext('2d');
    sensorChart = new Chart(ctx, {
      type: 'line',
      data: chartData,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: {
            type: 'linear',
            title: {
              display: true,
              text: 'Time (minutes ago)'
            },
            ticks: {
              callback: function(value) {
                return Math.round(value) + 'm';
              }
            }
          },
          y: {
            title: {
              display: true,
              text: 'Voltage (V)'
            }
          }
        },
        plugins: {
          legend: {
            display: true,
            position: 'top'
          }
        },
        animation: {
          duration: 0
        }
      }
    });
  }

  // Load sensor configuration and initialize chart datasets
  function loadSensorConfig() {
    const config = adaStore.config.value;
    if (config.data?.sensors) {
      chartData.datasets = config.data.sensors.map((sensor, index) => ({
        label: sensor.name || `Sensor ${sensor.id}`,
        data: [],
        borderColor: getColorForIndex(index),
        backgroundColor: getColorForIndex(index, 0.1),
        tension: 0.1,
        pointRadius: 2
      }));
      
      document.getElementById('total-sensors').textContent = config.data.sensors.length;
      sensorChart?.update();
      updateSensorList(config.data.sensors);
    }
  }

  // Update sensor list in the UI
  function updateSensorList(sensors) {
    const container = document.getElementById('sensor-list');
    if (!container) return;
    
    container.innerHTML = sensors.map(sensor => `
      <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg">
        <div class="flex items-center">
          <div class="w-3 h-3 bg-green-400 rounded-full mr-3"></div>
          <div>
            <div class="font-medium text-gray-900">${sensor.name || `Sensor ${sensor.id}`}</div>
            <div class="text-sm text-gray-500">${sensor.type || 'Analog Voltage'}</div>
          </div>
        </div>
        <div class="text-right">
          <div class="font-medium text-gray-900" id="sensor-value-${sensor.id}">--</div>
          <div class="text-sm text-gray-500">V</div>
        </div>
      </div>
    `).join('');
  }

  // Get color for chart datasets
  function getColorForIndex(index, alpha = 1) {
    const colors = [
      `rgba(59, 130, 246, ${alpha})`,  // Blue
      `rgba(16, 185, 129, ${alpha})`,  // Green
      `rgba(245, 158, 11, ${alpha})`,  // Yellow
      `rgba(239, 68, 68, ${alpha})`,   // Red
      `rgba(139, 92, 246, ${alpha})`,  // Purple
      `rgba(236, 72, 153, ${alpha})`,  // Pink
    ];
    return colors[index % colors.length];
  }

  // Handle sensor data updates
  function handleSensorData() {
    if (isPaused) return;
    
    const sensorData = adaStore.sensors.value;
    if (!sensorData.data?.sensors) return;
    
    const now = Date.now();
    
    // Add new data point with relative time (minutes ago)
    const timePoint = 0; // Current time is 0 minutes ago
    chartData.labels.push(timePoint);
    
    // Update each sensor dataset
    sensorData.data.sensors.forEach((sensor, index) => {
      if (chartData.datasets[index]) {
        chartData.datasets[index].data.push({
          x: timePoint,
          y: sensor.voltage
        });
        
        // Update sensor value in the list
        const valueElement = document.getElementById(`sensor-value-${sensor.id}`);
        if (valueElement) {
          valueElement.textContent = sensor.voltage?.toFixed(3) || '--';
        }
      }
    });
    
    // Keep only recent data points and update time values
    const maxPoints = 50;
    if (chartData.labels.length > maxPoints) {
      chartData.labels.shift();
      chartData.datasets.forEach(dataset => dataset.data.shift());
    }
    
    // Update x values to be relative to current time
    chartData.datasets.forEach(dataset => {
      dataset.data.forEach((point, idx) => {
        point.x = -(chartData.labels.length - idx - 1); // Negative minutes ago
      });
    });
    
    sensorChart?.update();
  }

  // Load system status
  function loadSystemStatus() {
    const systemData = adaStore.system.value;
    if (systemData.status) {
      // Update system health
      const healthScore = 100; // Calculate based on status
      document.getElementById('system-health').textContent = healthScore + '%';
      
      // Update usage bars (mock data for now)
      const cpuUsage = Math.floor(Math.random() * 30) + 20;
      const memoryUsage = Math.floor(Math.random() * 40) + 30;
      const storageUsage = Math.floor(Math.random() * 20) + 10;
      
      document.getElementById('cpu-usage').textContent = cpuUsage + '%';
      document.getElementById('cpu-usage-bar').style.width = cpuUsage + '%';
      
      document.getElementById('memory-usage').textContent = memoryUsage + '%';
      document.getElementById('memory-usage-bar').style.width = memoryUsage + '%';
      
      document.getElementById('storage-usage').textContent = storageUsage + '%';
      document.getElementById('storage-usage-bar').style.width = storageUsage + '%';
    }
  }

  // Load recent alarms
  function loadRecentAlarms() {
    // Mock alarms for now
    const alarms = [];
    const container = document.getElementById('recent-alarms');
    
    if (alarms.length > 0 && container) {
      container.innerHTML = alarms.slice(0, 5).map(alarm => `
        <div class="flex items-center p-3 bg-${alarm.level === 'CRITICAL' ? 'red' : alarm.level === 'WARNING' ? 'yellow' : 'blue'}-50 rounded-lg">
          <i class="fas fa-exclamation-triangle text-${alarm.level === 'CRITICAL' ? 'red' : alarm.level === 'WARNING' ? 'yellow' : 'blue'}-500 mr-3"></i>
          <div class="flex-1">
            <div class="text-sm font-medium text-gray-900">${alarm.message}</div>
            <div class="text-xs text-gray-500">${format(new Date(alarm.timestamp), 'HH:mm:ss')}</div>
          </div>
        </div>
      `).join('');
      
      document.getElementById('active-alarms').textContent = alarms.filter(a => a.active).length;
    } else if (container) {
      container.innerHTML = '<div class="text-sm text-gray-500 text-center">No recent alarms</div>';
      document.getElementById('active-alarms').textContent = '0';
    }
  }

  // Quick action functions
  async function toggleSimulationMode() {
    try {
      showToast('Simulation', 'Simulation mode toggled', 'success');
    } catch (error) {
      showToast('Simulation', 'Failed to toggle simulation mode', 'error');
    }
  }

  async function exportData() {
    try {
      const sensorData = adaStore.sensors.value.data;
      if (sensorData) {
        // Create and download JSON file
        const dataStr = JSON.stringify(sensorData, null, 2);
        const blob = new Blob([dataStr], { type: 'application/json' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `ada-data-${new Date().toISOString().split('T')[0]}.json`;
        a.click();
        window.URL.revokeObjectURL(url);
        showToast('Export', 'Data exported successfully', 'success');
      }
    } catch (error) {
      showToast('Export', 'Failed to export data', 'error');
    }
  }

  async function resetAlarms() {
    try {
      loadRecentAlarms();
      showToast('Alarms', 'Alarms cleared successfully', 'success');
    } catch (error) {
      showToast('Alarms', 'Failed to clear alarms', 'error');
    }
  }

  // Event listeners
  function setupEventListeners() {
    document.getElementById('pause-chart')?.addEventListener('click', (e) => {
      isPaused = !isPaused;
      e.target.innerHTML = isPaused ? '<i class="fas fa-play mr-1"></i> Resume' : '<i class="fas fa-pause mr-1"></i> Pause';
    });

    document.getElementById('chart-timespan')?.addEventListener('change', () => {
      // Clear existing data and reload
      chartData.labels = [];
      chartData.datasets.forEach(dataset => dataset.data = []);
      sensorChart?.update();
    });

    // Make functions globally available for button onclick handlers
    window.toggleSimulationMode = toggleSimulationMode;
    window.exportData = exportData;
    window.resetAlarms = resetAlarms;
  }

  // Initialize dashboard when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    console.log('Dashboard initializing...');
    
    // Wait for adaStore to be ready
    function setupStoreSubscriptions() {
      if (typeof window.adaStore !== 'undefined') {
        // Subscribe to store changes
        window.adaStore.sensors.subscribe(() => handleSensorData());
        window.adaStore.system.subscribe(() => loadSystemStatus());
        window.adaStore.config.subscribe(() => loadSensorConfig());
        console.log('adaStore subscriptions established');
        
        // Now that store is ready, load initial data
        loadSensorConfig();
        loadSystemStatus();
        loadRecentAlarms();
        
        // Set up periodic updates
        setInterval(loadSystemStatus, 30000);
        setInterval(loadRecentAlarms, 60000);
      } else {
        console.warn('adaStore still not available');
      }
    }
    
    // Listen for store ready event
    window.addEventListener('ada:store-ready', setupStoreSubscriptions);
    
    // Also try immediately in case store is already ready
    if (typeof window.adaStore !== 'undefined') {
      setupStoreSubscriptions();
    }
    
    // Wait for Chart.js to be available
    if (typeof Chart !== 'undefined') {
      initChart();
    } else {
      // Retry in 100ms if Chart.js not ready
      setTimeout(() => {
        if (typeof Chart !== 'undefined') {
          initChart();
        } else {
          console.error('Chart.js not available');
        }
      }, 100);
    }
    
    setupEventListeners();
  });

  // Listen for custom state change events
  window.addEventListener('ada:state-changed', () => {
    handleSensorData();
    loadSystemStatus();
  });

  // Helper functions for missing dependencies
  function format(date, pattern) {
    const hours = date.getHours().toString().padStart(2, '0');
    const minutes = date.getMinutes().toString().padStart(2, '0');
    const seconds = date.getSeconds().toString().padStart(2, '0');
    
    if (pattern === 'HH:mm:ss') {
      return `${hours}:${minutes}:${seconds}`;
    }
    return date.toLocaleTimeString();
  }

  function showToast(title, message, type) {
    if (window.adaActions && window.adaActions.addNotification) {
      window.adaActions.addNotification(title, message, type);
    } else {
      console.log(`[${type.toUpperCase()}] ${title}: ${message}`);
    }
  }
</script>
