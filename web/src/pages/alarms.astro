  // Modal functions
  function createAlarm() {
    document.getElementById('alarm-modal')?.classList.remove('hidden');
    document.getElementById('alarm-modal')?.classList.add('flex');
  }

  function closeAlarmModal() {
    document.getElementById('alarm-modal')?.classList.add('hidden');
    document.getElementById('alarm-modal')?.classList.remove('flex');
    
    // Reset form
    const form = document.getElementById('alarm-form') as HTMLFormElement;
    if (form) form.reset();
  }

  async function saveAlarmRule() {
    const ruleName = (document.getElementById('rule-name') as HTMLInputElement)?.value;
    const sensorId = (document.getElementById('rule-sensor') as HTMLSelectElement)?.value;
    const condition = (document.getElementById('rule-condition') as HTMLSelectElement)?.value;
    const threshold = parseFloat((document.getElementById('rule-threshold') as HTMLInputElement)?.value);
    const severity = (document.getElementById('rule-severity') as HTMLSelectElement)?.value;
    const description = (document.getElementById('rule-description') as HTMLTextAreaElement)?.value;

    if (!ruleName || !sensorId || !condition || isNaN(threshold) || !severity) {
      if (window.adaActions) {
        window.adaActions.addNotification('Please fill in all required fields', 'error');
      }
      return;
    }

    try {
      const response = await fetch('/api/alarms/rules', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: ruleName,
          sensorId: parseInt(sensorId),
          condition,
          threshold,
          severity,
          description
        })
      });

      if (response.ok) {
        closeAlarmModal();
        await loadAlarmData();
        if (window.adaActions) {
          window.adaActions.addNotification('Alarm rule created successfully', 'success');
        }
      } else {
        throw new Error('Failed to create alarm rule');
      }
    } catch (error) {
      console.error('Failed to create alarm rule:', error);
      if (window.adaActions) {
        window.adaActions.addNotification('Failed to create alarm rule', 'error');
      }
    }
  }

  async function saveNotificationSettings() {
    const settings = {
      email: (document.getElementById('email-notifications') as HTMLInputElement)?.checked,
      sms: (document.getElementById('sms-notifications') as HTMLInputElement)?.checked,
      push: (document.getElementById('push-notifications') as HTMLInputElement)?.checked,
      sound: (document.getElementById('sound-alerts') as HTMLInputElement)?.checked
    };

    try {
      const response = await fetch('/api/alarms/notification-settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(settings)
      });

      if (response.ok) {
        if (window.adaActions) {
