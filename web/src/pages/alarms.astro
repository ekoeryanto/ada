        }
      } else {
        throw new Error('Failed to save notification settings');
      }
    } catch (error) {
      console.error('Failed to save notification settings:', error);
      if (window.adaActions) {
        window.adaActions.addNotification('Failed to save notification settings', 'error');
      }
    }
  }

