---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout 
  title="Analog Voltage Sensors (0-10V)" 
  description="Monitor and calibrate 0-10V analog voltage sensors"
  activePage="analog-voltage"
>
  <!-- Connection Status -->
  <div class="mb-6 text-center">
    <div id="connection-status" class="inline-flex items-center px-4 py-2 rounded-full bg-green-500/20 text-green-400 border border-green-500/30">
      <div class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></div>
      <span class="text-sm font-medium">Connected</span>
    </div>
  </div>

      <!-- Voltage Sensors Grid -->
      <div class="grid lg:grid-cols-3 gap-6 mb-8" id="sensors-grid">
        <!-- Sensors will be populated by JavaScript -->
      </div>

      <!-- System Overview -->
      <div class="grid lg:grid-cols-2 gap-8 mb-8">
        <!-- Calibration Panel -->
        <div class="bg-slate-800/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700/50">
          <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
            <svg class="w-6 h-6 mr-2 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"></path>
            </svg>
            Sensor Calibration
          </h2>
          <div class="space-y-4">
            <select id="calibration-sensor" 
                    class="w-full px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white focus:border-blue-500 focus:outline-none">
              <option value="">Select Sensor</option>
            </select>
            <div class="grid grid-cols-2 gap-3">
              <input id="calibration-offset" type="number" step="0.001" placeholder="Offset" 
                     class="px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:border-blue-500 focus:outline-none">
              <input id="calibration-scale" type="number" step="0.001" placeholder="Scale" 
                     class="px-3 py-2 bg-slate-700 border border-slate-600 rounded-lg text-white placeholder-slate-400 focus:border-blue-500 focus:outline-none">
            </div>
            <div class="flex space-x-2">
              <button id="calibrate-btn" 
                      class="flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors">
                Apply Calibration
              </button>
              <button id="reset-calibration-btn" 
                      class="flex-1 px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-medium transition-colors">
                Reset
              </button>
            </div>
          </div>
        </div>

        <!-- Health Status -->
        <div class="bg-slate-800/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700/50">
          <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
            <svg class="w-6 h-6 mr-2 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
            Sensor Health
          </h2>
          <div id="health-status" class="space-y-4">
            <!-- Health status will be populated by JavaScript -->
          </div>
        </div>
      </div>

      <!-- Historical Data Chart -->
      <div class="bg-slate-800/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700/50 mb-8">
        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
          <svg class="w-6 h-6 mr-2 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
          </svg>
          Voltage Trends (Last 1 Hour)
        </h2>
        <div class="h-64 bg-slate-900/50 rounded-lg flex items-center justify-center">
          <canvas id="trend-chart" width="800" height="200" class="max-w-full"></canvas>
        </div>
      </div>

      <!-- System Information -->
      <div class="grid lg:grid-cols-3 gap-6">
        <div class="bg-slate-800/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700/50">
          <h3 class="text-lg font-semibold text-white mb-4">Sensor Information</h3>
          <div id="sensor-info" class="space-y-2">
            <!-- Sensor info will be populated by JavaScript -->
          </div>
        </div>
        
        <div class="bg-slate-800/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700/50">
          <h3 class="text-lg font-semibold text-white mb-4">Sampling Statistics</h3>
          <div id="sampling-stats" class="space-y-2">
            <!-- Sampling stats will be populated by JavaScript -->
          </div>
        </div>

        <div class="bg-slate-800/50 backdrop-blur-sm rounded-xl p-6 border border-slate-700/50">
          <h3 class="text-lg font-semibold text-white mb-4">System Status</h3>
          <div id="system-status" class="space-y-2">
            <!-- System status will be populated by JavaScript -->
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    import { adaApi } from '../lib/api';

    let updateInterval: ReturnType<typeof setInterval>;
    let chartData: number[][] = []; // Data for sensors
    let isConnected = true;

    // DOM elements
    const connectionStatus = document.getElementById('connection-status')!;
    const sensorsGrid = document.getElementById('sensors-grid')!;
    const healthStatus = document.getElementById('health-status')!;
    const sensorInfo = document.getElementById('sensor-info')!;
    const samplingStats = document.getElementById('sampling-stats')!;
    const systemStatus = document.getElementById('system-status')!;
    const chartCanvas = document.getElementById('trend-chart') as HTMLCanvasElement;
    const calibrationSensor = document.getElementById('calibration-sensor') as HTMLSelectElement;
    const calibrateBtn = document.getElementById('calibrate-btn') as HTMLButtonElement;
    const resetCalibrationBtn = document.getElementById('reset-calibration-btn') as HTMLButtonElement;

    // Chart context
    const ctx = chartCanvas.getContext('2d')!;

    // Update connection status
    function updateConnectionStatus(connected: boolean) {
      isConnected = connected;
      if (connected) {
        connectionStatus.className = 'inline-flex items-center px-4 py-2 rounded-full bg-green-500/20 text-green-400 border border-green-500/30';
        connectionStatus.innerHTML = `
          <div class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></div>
          <span class="text-sm font-medium">Connected</span>
        `;
      } else {
        connectionStatus.className = 'inline-flex items-center px-4 py-2 rounded-full bg-red-500/20 text-red-400 border border-red-500/30';
        connectionStatus.innerHTML = `
          <div class="w-2 h-2 bg-red-400 rounded-full mr-2"></div>
          <span class="text-sm font-medium">Disconnected</span>
        `;
      }
    }

    // Get status color and text
    function getStatusDisplay(status: string) {
      switch (status) {
        case 'OK':
          return { color: 'text-green-400', bgColor: 'bg-green-500/20', borderColor: 'border-green-500/30', text: 'GOOD' };
        case 'WARNING':
          return { color: 'text-yellow-400', bgColor: 'bg-yellow-500/20', borderColor: 'border-yellow-500/30', text: 'WARNING' };
        case 'ERROR':
          return { color: 'text-red-400', bgColor: 'bg-red-500/20', borderColor: 'border-red-500/30', text: 'ERROR' };
        default:
          return { color: 'text-slate-400', bgColor: 'bg-slate-500/20', borderColor: 'border-slate-500/30', text: 'UNKNOWN' };
      }
    }

    // Map sensor key to GPIO pin (based on pins_config.h and ESP32 firmware)
    function getGPIOPin(key: string): number {
      const pinMap: { [key: string]: number } = {
        'a11': 35,  // A11 -> GPIO 35 (AI1_PIN)
        'a12': 34,  // A12 -> GPIO 34 (AI2_PIN)  
        'a13': 36   // A13 -> GPIO 36 (AI3_PIN)
      };
      return pinMap[key.toLowerCase()] || 0;
    }

    // Render voltage sensors
    function renderSensors(sensors: any) {
      if (!sensors || typeof sensors !== 'object') {
        sensorsGrid.innerHTML = '<div class="text-slate-400">No sensor data available</div>';
        return;
      }

      sensorsGrid.innerHTML = Object.entries(sensors).map(([key, sensor]: [string, any]) => {
        const statusDisplay = getStatusDisplay(sensor.status || 'OK');
        const voltagePercent = Math.min(Math.max((sensor.value / 10) * 100, 0), 100);
        // Convert key to display name: a11 -> A11, a12 -> A12, a13 -> A13 (matching ESP32 firmware)
        const displayName = key.toUpperCase(); 
        const gpioPin = getGPIOPin(key);
        
        return `
          <div class="bg-slate-800/50 backdrop-blur-sm rounded-xl p-6 border ${statusDisplay.borderColor}">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-white">${displayName} (GPIO${gpioPin})</h3>
              <div class="px-2 py-1 rounded-full text-xs font-medium ${statusDisplay.bgColor} ${statusDisplay.color} ${statusDisplay.borderColor} border">
                ${statusDisplay.text}
              </div>
            </div>
            
            <div class="mb-4">
              <div class="flex justify-between text-sm mb-2">
                <span class="text-slate-400">Voltage</span>
                <span class="text-white font-bold">${sensor.value.toFixed(3)} V</span>
              </div>
              <div class="w-full bg-slate-700 rounded-full h-3">
                <div class="bg-gradient-to-r from-yellow-500 to-orange-400 h-3 rounded-full transition-all duration-500" 
                     style="width: ${voltagePercent}%"></div>
              </div>
              <div class="flex justify-between text-xs text-slate-400 mt-1">
                <span>0V</span>
                <span>${voltagePercent.toFixed(1)}%</span>
                <span>10V</span>
              </div>
            </div>

            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-slate-400">Raw ADC:</span>
                <span class="text-white">${sensor.raw_adc || 0}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Location:</span>
                <span class="text-white">${sensor.location || 'Not Set'}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Enabled:</span>
                <span class="text-white">${sensor.enabled ? 'Yes' : 'No'}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Health Score:</span>
                <span class="text-white">${(sensor.health_score || 0).toFixed(1)}%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-400">Last Update:</span>
                <span class="text-white">${sensor.timestamp ? new Date(sensor.timestamp * 1000).toLocaleTimeString() : 'N/A'}</span>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Update calibration sensor select
    function updateCalibrationSensor(sensors: any) {
      if (!sensors || typeof sensors !== 'object') {
        calibrationSensor.innerHTML = '<option value="">No sensors available</option>';
        return;
      }

      const options = Object.entries(sensors).map(([key, sensor]: [string, any]) => {
        const gpioPin = getGPIOPin(key);
        return `<option value="${key}">${key.toUpperCase()} (GPIO${gpioPin}) - ${sensor.location || 'Unknown'}</option>`;
      }).join('');
      
      calibrationSensor.innerHTML = '<option value="">Select Sensor</option>' + options;
    }

    // Simple chart drawing function
    function drawChart() {
      const width = chartCanvas.width;
      const height = chartCanvas.height;
      
      // Clear canvas
      ctx.clearRect(0, 0, width, height);
      
      // Draw grid
      ctx.strokeStyle = '#374151';
      ctx.lineWidth = 1;
      
      // Horizontal lines
      for (let i = 0; i <= 5; i++) {
        const y = (height / 5) * i;
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.stroke();
      }
      
      // Vertical lines
      for (let i = 0; i <= 10; i++) {
        const x = (width / 10) * i;
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }
      
      // Draw data lines
      const colors = ['#FBBF24', '#F59E0B', '#D97706']; // Yellow, Orange, Amber
      
      chartData.forEach((sensorData, sensorIndex) => {
        if (sensorData.length < 2) return;
        
        ctx.strokeStyle = colors[sensorIndex] || '#6B7280';
        ctx.lineWidth = 2;
        ctx.beginPath();
        
        sensorData.forEach((value, index) => {
          const x = (width / (sensorData.length - 1)) * index;
          const y = height - ((value / 10) * height); // Scale 0-10V to canvas height
          
          if (index === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
        });
        
        ctx.stroke();
      });
      
      // Draw labels
      ctx.fillStyle = '#9CA3AF';
      ctx.font = '12px monospace';
      ctx.fillText('10V', 5, 15);
      ctx.fillText('0V', 5, height - 5);
    }

    // Update chart data
    function updateChartData(sensors: any[]) {
      sensors.forEach((sensor, index) => {
        if (!chartData[index]) chartData[index] = [];
        
        chartData[index].push(sensor.voltage);
        
        // Keep only last 50 points
        if (chartData[index].length > 50) {
          chartData[index].shift();
        }
      });
      
      drawChart();
    }

    // Render health status
    async function renderHealthStatus() {
      try {
        const health = await adaApi.getSensorHealth();
        
        if (health && health.sensors) {
          // Check if sensors is object or array format
          const sensorsData = Array.isArray(health.sensors) ? health.sensors : Object.entries(health.sensors);
          
          healthStatus.innerHTML = sensorsData.map((item: any) => {
            // Handle both array and object formats
            const sensor = Array.isArray(health.sensors) ? item : item[1];
            const sensorKey = Array.isArray(health.sensors) ? `AI${sensor.id}` : item[0].toUpperCase();
            
            return `
              <div class="bg-slate-700/50 rounded-lg p-4">
                <div class="flex justify-between items-center mb-2">
                  <h4 class="font-semibold text-white">${sensorKey}</h4>
                  <span class="text-sm ${sensor.health === 'OK' ? 'text-green-400' : 'text-red-400'}">
                    ${sensor.health || 'OK'}
                  </span>
                </div>
                <div class="text-sm text-slate-400">
                  <div>Error Count: ${sensor.error_count || 0}</div>
                  <div>Last Reading: ${sensor.last_reading ? new Date(sensor.last_reading * 1000).toLocaleTimeString() : 'N/A'}</div>
                </div>
              </div>
            `;
          }).join('');
        } else {
          healthStatus.innerHTML = '<div class="text-slate-400 text-sm">No health data available</div>';
        }
      } catch (error) {
        healthStatus.innerHTML = '<div class="text-red-400 text-sm">Failed to load health status</div>';
      }
    }

    // Update statistics
    function updateStats(sensors: any, metadata?: any) {
      if (!sensors || typeof sensors !== 'object') {
        sensorInfo.innerHTML = '<div class="text-slate-400">No sensor data</div>';
        samplingStats.innerHTML = '<div class="text-slate-400">No statistics</div>';
        return;
      }

      const sensorArray = Object.values(sensors);
      const totalSensors = sensorArray.length;
      const activeSensors = sensorArray.filter((s: any) => s.enabled && s.valid).length;
      const avgVoltage = sensorArray.reduce((sum: number, s: any) => sum + (s.value || 0), 0) / totalSensors;
      const voltages = sensorArray.map((s: any) => s.value || 0);
      
      sensorInfo.innerHTML = `
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Total Sensors:</span>
          <span class="text-white">${totalSensors}</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Active Sensors:</span>
          <span class="text-green-400">${activeSensors}</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Resolution:</span>
          <span class="text-white">${metadata?.resolution || 12}-bit</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Reference:</span>
          <span class="text-white">${metadata?.reference_voltage || 3.3}V</span>
        </div>
      `;

      samplingStats.innerHTML = `
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Avg Voltage:</span>
          <span class="text-white">${avgVoltage.toFixed(3)}V</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Min Voltage:</span>
          <span class="text-white">${Math.min(...voltages).toFixed(3)}V</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Max Voltage:</span>
          <span class="text-white">${Math.max(...voltages).toFixed(3)}V</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Range:</span>
          <span class="text-white">${(Math.max(...voltages) - Math.min(...voltages)).toFixed(3)}V</span>
        </div>
        <div class="flex justify-between text-sm">
          <span class="text-slate-400">Sampling Rate:</span>
          <span class="text-white">${metadata?.sampling_rate || 1} Hz</span>
        </div>
      `;
    }

    // Update system status
    async function updateSystemStatus() {
      try {
        const status = await adaApi.getStatus();
        systemStatus.innerHTML = `
          <div class="flex justify-between text-sm">
            <span class="text-slate-400">Uptime:</span>
            <span class="text-white">${Math.floor((Number(status.uptime) || 0) / 3600)}h ${Math.floor(((Number(status.uptime) || 0) % 3600) / 60)}m</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-slate-400">ADC Status:</span>
            <span class="text-green-400">Active</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-slate-400">Free Memory:</span>
            <span class="text-white">${Math.round((status.freeHeap || 0) / 1024)}KB</span>
          </div>
        `;
      } catch (error) {
        systemStatus.innerHTML = `
          <div class="text-sm text-red-400">Failed to load system status</div>
        `;
      }
    }

    // Calibration functions
    async function applyCalibraton() {
      const sensorId = parseInt(calibrationSensor.value);
      const offsetInput = document.getElementById('calibration-offset') as HTMLInputElement;
      const scaleInput = document.getElementById('calibration-scale') as HTMLInputElement;

      if (!sensorId) {
        alert('Please select a sensor');
        return;
      }

      const offset = parseFloat(offsetInput.value) || 0;
      const scale = parseFloat(scaleInput.value) || 1;

      try {
        await adaApi.calibrateSensor({ sensor: sensorId, offset, scale });
        alert('Calibration applied successfully');
        
        // Clear inputs
        offsetInput.value = '';
        scaleInput.value = '';
        
        // Refresh data
        await updateData();
      } catch (error) {
        alert('Failed to apply calibration');
      }
    }

    async function resetCalibration() {
      const sensorId = parseInt(calibrationSensor.value);

      if (!sensorId) {
        alert('Please select a sensor');
        return;
      }

      if (!confirm(`Reset calibration for sensor AI${sensorId}?`)) {
        return;
      }

      try {
        await adaApi.resetCalibration(sensorId);
        alert('Calibration reset successfully');
        await updateData();
      } catch (error) {
        alert('Failed to reset calibration');
      }
    }

    // Main update function
    async function updateData() {
      try {
        const data = await adaApi.getAnalogVoltage();
        updateConnectionStatus(true);
        
        if (data && data.sensors) {
          renderSensors(data.sensors);
          updateCalibrationSensor(data.sensors);
          updateStats(data.sensors, data.metadata);
          updateChartData(data.sensors);
        }
        
      } catch (error) {
        console.error('Failed to update analog voltage data:', error);
        updateConnectionStatus(false);
      }
    }

    // Event listeners
    calibrateBtn.addEventListener('click', applyCalibraton);
    resetCalibrationBtn.addEventListener('click', resetCalibration);

    // Initialize the page
    async function init() {
      await updateData();
      await updateSystemStatus();
      await renderHealthStatus();
      
      // Set up real-time updates every 2 seconds
      updateInterval = setInterval(updateData, 2000);
      
      // Update system info and health every 30 seconds
      setInterval(() => {
        updateSystemStatus();
        renderHealthStatus();
      }, 30000);
    }

    // Cleanup on page unload
    window.addEventListener('beforeunload', () => {
      if (updateInterval) {
        clearInterval(updateInterval);
      }
    });

    // Start the application
    init();
  </script>
</DashboardLayout>